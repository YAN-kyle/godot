<Project>
  <PropertyGroup>
    <UseMonoRuntime Condition=" '$(UseMonoRuntime)' == '' and '$(PublishAot)' != 'true' ">true</UseMonoRuntime>

    <!-- Default to relinking in ExportDebug and ExportRelease configurations. -->
    <WasmBuildNative Condition=" '$(WasmBuildNative)' == '' and '$(Configuration)' == 'ExportDebug' ">true</WasmBuildNative>
    <WasmBuildNative Condition=" '$(WasmBuildNative)' == '' and '$(Configuration)' == 'ExportRelease' ">true</WasmBuildNative>
  </PropertyGroup>

  <!-- Configuration for the Mono WASM runtime. Must match the features enabled on GetRuntimePack.csproj. -->
  <PropertyGroup>
    <!-- The Godot export passes WasmEnableThreads to match the preset's thread support. -->
    <WasmEnableThreads Condition=" '$(WasmEnableThreads)' == '' ">false</WasmEnableThreads>
    <WasmEnableExceptionHandling>true</WasmEnableExceptionHandling>
    <WasmEnableSIMD>true</WasmEnableSIMD>
  </PropertyGroup>

  <!-- The runtime pack's ICU data files are always published. Only keep the one the game loads. -->
  <Target Name="_GodotSelectWebIcuData" AfterTargets="ComputeResolvedFilesToPublishList">
    <PropertyGroup>
      <_GodotWebIcuDataFileName>icudt</_GodotWebIcuDataFileName>
      <_GodotWebIcuDataFileName Condition=" '$(WasmIcuDataFileName)' != '' ">$([System.IO.Path]::GetFileNameWithoutExtension('$(WasmIcuDataFileName)'))</_GodotWebIcuDataFileName>
    </PropertyGroup>
    <ItemGroup>
      <_GodotWebIcuData Include="@(ResolvedFileToPublish)" Condition=" '%(Extension)' == '.dat' and $([System.String]::Copy('%(Filename)').StartsWith('icudt')) " />
      <ResolvedFileToPublish Remove="@(_GodotWebIcuData)" />
      <ResolvedFileToPublish Include="@(_GodotWebIcuData)" Condition=" '$(InvariantGlobalization)' != 'true' and '%(Filename)' == '$(_GodotWebIcuDataFileName)' " />
    </ItemGroup>
    <Error Condition=" '$(InvariantGlobalization)' != 'true' and '@(_GodotWebIcuData)' != '' and !@(ResolvedFileToPublish->AnyHaveMetadataValue('Filename', '$(_GodotWebIcuDataFileName)')) " Text="ICU data file '$(_GodotWebIcuDataFileName).dat' (WasmIcuDataFileName) isn't one of the runtime pack's: @(_GodotWebIcuData->'%(Filename)%(Extension)')." />
  </Target>

  <!--
    GodotSharp is kept whole by default, since it isn't annotated for trimming (it uses reflection
    on script and Godot types). Projects can set GodotTrimGodotSharp to true to let the trimmer
    remove its unused members instead, which makes the exported GodotSharp.dll about 55% smaller
    (5.9 MB -> 2.7 MB). Test the exported game when doing so: code that reflects on Godot types
    may fail at runtime.
  -->
  <ItemGroup>
    <TrimmerRootAssembly Include="GodotSharp" Condition="'$(EnableGodotDotNetPreview)' != 'true' and '$(DisableImplicitGodotSharpReferences)' != 'true' and '$(GodotTrimGodotSharp)' != 'true'" />
    <TrimmerRootAssembly Include="Godot.Bindings" Condition="'$(EnableGodotDotNetPreview)' == 'true'" />
    <TrimmerRootAssembly Include="$(TargetName)" />
  </ItemGroup>

  <!--
    The trimmer only runs again when its input files change, not when its roots do (for example
    when GodotTrimGodotSharp is toggled), which would export the previous trimmed assemblies.
    Record the roots in a file that is only rewritten when they change, and make it an input.
  -->
  <Target Name="_GodotTrackTrimmerRoots" AfterTargets="PrepareForILLink">
    <PropertyGroup>
      <_GodotTrimmerRootsFile>$(IntermediateOutputPath)godot-trimmer-roots.txt</_GodotTrimmerRootsFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(_GodotTrimmerRootsFile)" Lines="@(TrimmerRootAssembly)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(_GodotTrimmerRootsFile)" />
    </ItemGroup>
    <PropertyGroup>
      <MSBuildAllProjects>$(MSBuildAllProjects);$(_GodotTrimmerRootsFile)</MSBuildAllProjects>
    </PropertyGroup>
  </Target>
</Project>
